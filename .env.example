# Public values used by the browser and by the connection check.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-aqui
SUPABASE_SECRET_KEY=sb_secret_sua-chave-de-servidor-aqui
EVERFLOW_TOKEN=seu-token-everflow-aqui
OPENAI_API_KEY=sk-sua-chave-openai-aqui

# Safe by default. Change to false only after approving a complete dry-run log.
DRY_RUN=true
OPENAI_MODEL=gpt-4.1-mini
LLM_BATCH_SIZE=25
EVERFLOW_WINDOW_MONTHS=6

# Optional. Defaults to 8000.
PORT=8000
